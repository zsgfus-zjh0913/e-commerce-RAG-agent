# ── LLM 配置 ──
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库配置 ──
# 开发模式（默认 SQLite，无需配置）：
#   留空即可，自动使用本地 ecommerce.db
# 生产模式（MySQL）：
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ecommerce?charset=utf8mb4
# 生产模式（PostgreSQL）：
#   DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
DATABASE_URL=

# ── Redis 配置 ──
# 开发模式（无需 Redis，自动降级为内存存储）：
#   留空即可
# 生产模式：
#   REDIS_URL=redis://localhost:6379/0
#   带密码：REDIS_URL=redis://:password@localhost:6379/0
REDIS_URL=

# ── 安全配置 ──
# JWT 签名密钥（生产环境必须修改）
SECRET_KEY=change-this-to-a-random-string-in-production
# Agent JWT 签名密钥
AGENT_JWT_SECRET=change-this-too

# ── 服务器配置 ──
# Flask 调试模式（生产环境设为 false）
FLASK_DEBUG=false
# 监听端口
PORT=5000

# ── 商品多模态检索 ──
# OCR 引擎：auto 会优先 PaddleOCR，不可用时回退 RapidOCR
MULTIMODAL_OCR_ENGINE=auto
# 中文 CLIP 模型
MULTIMODAL_CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# 图片商品匹配最低分数
MULTIMODAL_MIN_SCORE=0.15
