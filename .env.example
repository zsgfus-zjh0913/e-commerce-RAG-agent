# ── LLM 配置 ──
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库配置 ──
# 开发模式（默认 SQLite，无需配置）：
#   留空即可，自动使用本地 ecommerce.db
# 生产模式（MySQL）：
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ecommerce?charset=utf8mb4
# 生产模式（PostgreSQL）：
#   DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
DATABASE_URL=

# ── Redis 配置 ──
# 开发模式（无需 Redis，自动降级为内存存储）：
#   留空即可
# 生产模式：
#   REDIS_URL=redis://localhost:6379/0
#   带密码：REDIS_URL=redis://:password@localhost:6379/0
REDIS_URL=

# ── 安全配置 ──
# 开发默认 development；生产必须设置为 production
APP_ENV=development
# Flask Session 密钥（生产环境必须修改）
SECRET_KEY=change-this-to-a-random-string-in-production
# 用户 JWT 签名密钥（必须与 SECRET_KEY 不同）
JWT_SECRET=change-this-user-jwt-secret-in-production
# Agent JWT 签名密钥（必须与上面两个密钥不同）
AGENT_JWT_SECRET=change-this-agent-jwt-secret-in-production

# ── 高并发改造（可选，默认关闭保持零配置兼容）──

# 检索服务化：指向独立 rag_service 进程地址（生产建议开启）
#   开启后主应用不再加载 embedding/reranker 模型，检索走 HTTP 调用
#   例：RAG_SERVICE_URL=http://127.0.0.1:5001
RAG_SERVICE_URL=

# 聊天任务模式：1=提交即返回 task_id，生成在后台执行，SSE 事件增量拉取（生产建议开启）
CHAT_TASK_MODE=

# 向量存储：二选一
#   QDRANT_LOCAL_PATH=qdrant_data    本地嵌入模式（无需 Docker，单进程）
#   QDRANT_URL=http://qdrant:6333    远程 Qdrant 服务（支持更大并发/索引）
QDRANT_LOCAL_PATH=
QDRANT_URL=

# MySQL 连接池（多 worker 部署时预算：单 worker 峰值连接 = pool_size + max_overflow）
# POOL_SIZE=10
# POOL_MAX_OVERFLOW=20
# POOL_RECYCLE=2800

# ── 服务器配置 ──
# Flask 调试模式（生产环境设为 false）
FLASK_DEBUG=false
# 监听端口
PORT=5000

# ── 商品多模态检索 ──
# OCR 引擎：auto 会优先 PaddleOCR，不可用时回退 RapidOCR
MULTIMODAL_OCR_ENGINE=auto
# 中文 CLIP 模型
MULTIMODAL_CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# 图片商品匹配最低分数
MULTIMODAL_MIN_SCORE=0.15
